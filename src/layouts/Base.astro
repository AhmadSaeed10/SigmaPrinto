---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../site';

interface Props {
  title: string;
  description: string;
  path?: string;
  schema?: object[];
  type?: 'website' | 'article';
}
const { title, description, path = Astro.url.pathname, schema = [], type = 'website' } = Astro.props;
const canonical = new URL(path, site.url).href;
const sameAs: string[] = [];

const business = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${site.url}/#business`,
  name: site.name,
  url: site.url,
  description: site.description,
  logo: `${site.url}/brand/logo.png`,
  email: site.email,
  ...(site.phone && { telephone: site.phone }),
  ...(site.address && {
    address: { '@type': 'PostalAddress', streetAddress: site.address, addressLocality: site.city },
  }),
  ...(sameAs.length && { sameAs }),
};
const graph = [business, ...schema];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f4f6f9" />
    <script is:inline>
      // Set the theme before first paint to avoid a flash: saved choice, else the OS setting.
      (function () {
        var t = null;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
        document.documentElement.classList.add('js');
        // Failsafe: if the motion script never runs, show everything rather than leave content hidden.
        setTimeout(function () { if (!document.documentElement.classList.contains('motion')) document.documentElement.classList.remove('js'); }, 2500);
        if (t === 'dark') document.querySelector('meta[name="theme-color"]').setAttribute('content', '#0b1120');
      })();
    </script>
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    {graph.map((g) => <script type="application/ld+json" set:html={JSON.stringify(g)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <div id="cursor" class="cursor" aria-hidden="true">
      <svg class="cursor__mark" viewBox="0 0 40 40"><circle cx="20" cy="20" r="9" /><path d="M20 2v36M2 20h36" /></svg>
      <span class="cursor__label"></span>
    </div>
    <script>import '../scripts/motion';</script>
  </body>
</html>
