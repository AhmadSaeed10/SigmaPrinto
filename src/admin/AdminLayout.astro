---
import '@fontsource-variable/figtree/index.css';
import '@fontsource-variable/bricolage-grotesque/index.css';
import './client/admin.css';
import { contentTypes } from './registry';

interface Props { title: string; active?: string; data?: unknown; page: string; bare?: boolean }
const { title, active = '', data = {}, page, bare = false } = Astro.props;
const nav = [
  { key: 'dashboard', label: 'Dashboard', href: '/admin/', icon: 'home' },
  ...contentTypes.map((t) => ({ key: t.key, label: t.label, href: `/admin/${t.key}/`, icon: t.icon })),
  { key: 'media', label: 'Media', href: '/admin/media/', icon: 'image' },
];
const icons: Record<string, string> = {
  home: 'M3 11.5 12 4l9 7.5M5 10v10h5v-6h4v6h5V10',
  layers: 'm12 3 9 5-9 5-9-5 9-5Zm-9 9 9 5 9-5M3 16l9 5 9-5',
  book: 'M5 4h10a4 4 0 0 1 4 4v12H9a4 4 0 0 1-4-4V4Zm0 12a4 4 0 0 1 4-4h10',
  help: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm-2.5-11.5a2.5 2.5 0 1 1 3.5 2.3c-.6.3-1 .8-1 1.5V14m0 3v.01',
  settings: 'M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm7.4-3a7.4 7.4 0 0 0-.1-1.2l2-1.6-2-3.4-2.4 1a7.6 7.6 0 0 0-2-1.2L14.5 3h-5l-.4 2.6a7.6 7.6 0 0 0-2 1.2l-2.4-1-2 3.4 2 1.6a7.4 7.4 0 0 0 0 2.4l-2 1.6 2 3.4 2.4-1a7.6 7.6 0 0 0 2 1.2l.4 2.6h5l.4-2.6a7.6 7.6 0 0 0 2-1.2l2.4 1 2-3.4-2-1.6c.1-.4.1-.8.1-1.2Z',
  image: 'M4 5h16v14H4zM4 15l4.5-4.5 4 4 2.5-2.5L20 17M15.5 9.5h.01',
};
const json = JSON.stringify(data).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} | SigmaPrinto admin</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body data-page={page} class:list={[{ bare }]}>
    {bare ? <slot /> : (
      <div class="shell">
        <aside class="side" id="admin-nav">
          <a class="side__brand" href="/admin/"><img src="/brand/logo-header-white.svg" alt="SigmaPrinto" width="150" height="29" /><span>Admin</span></a>
          <nav aria-label="Admin">
            {nav.map((n) => (
              <a href={n.href} aria-current={active === n.key ? 'page' : undefined}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d={icons[n.icon]} /></svg>{n.label}
              </a>
            ))}
          </nav>
          <div class="side__foot">
            <a href="/" target="_blank" rel="noopener">View site ↗</a>
            <form method="post" action="/api/admin/logout/"><button type="submit" class="linkbtn">Log out</button></form>
          </div>
        </aside>
        <div class="main">
          <header class="top">
            <button class="iconbtn navtoggle" type="button" aria-controls="admin-nav" aria-expanded="false" aria-label="Open menu">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
            </button>
            <h1>{title}</h1>
            <div class="top__actions"><slot name="actions" /></div>
          </header>
          <main class="content"><slot /></main>
        </div>
      </div>
    )}
    <div class="toasts" role="status" aria-live="polite"></div>
    <script type="application/json" id="page-data" set:html={json}></script>
    <script>import './client/main';</script>
  </body>
</html>
