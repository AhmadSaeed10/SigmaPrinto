---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { site } from '../../site';

export async function getStaticPaths() {
  const guides = await getCollection('guides', (g) => !g.data.draft);
  return guides.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const schema = [{
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.description,
  datePublished: d.date.toISOString(),
  author: { '@id': `${site.url}/#business` },
  publisher: { '@id': `${site.url}/#business` },
}];
---
<Base title={`${d.title} | SigmaPrinto`} description={d.description} schema={schema} type="article">
  <div class="wrap page-head">
    <p class="crumbs"><a href="/">Home</a> / <a href="/guides/">Guides</a> / {d.title}</p>
    <h1 style="font-size: clamp(2.2rem, 5.5vw, 4rem)">{d.title}</h1>
  </div>
  <div class="wrap section" style="padding-top:1rem">
    <div class="prose"><Content /></div>
    <p style="margin-top:2rem"><a class="btn" href="/#quote">Get a quote</a></p>
  </div>
</Base>
