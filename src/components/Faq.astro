---
import { faqs } from '../data/faqs';
---
<section class="section" id="faq">
  <div class="wrap">
    <div class="section-head"><h2>Questions before you order</h2></div>
    <div class="faq">
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
