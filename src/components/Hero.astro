---
---
<section class="hero">
  <div class="wrap">
    <div class="hero-copy">
      <h1 class="misreg">Printing that matches the proof.</h1>
      <p>Flex banners, posters, vinyl, apparel and business print for brands and events. Send your artwork, approve a proof, and get exactly what you approved.</p>
      <div class="hero-actions">
        <a class="btn" href="#quote">Get a quote</a>
        <a class="btn btn-ghost" href="/services/">See what we print</a>
      </div>
      <p class="proof-note">Every order is checked for size, bleed and colour before it goes to press.</p>
    </div>

    <div class="sheet" role="img" aria-label="A press sheet showing a flex banner, a poster, a T-shirt and a mug laid out with crop marks and a CMYK colour bar">
      <svg viewBox="0 0 460 520" xmlns="http://www.w3.org/2000/svg">
        <!-- crop marks -->
        <g stroke="#0f1a33" stroke-width="1">
          <path d="M18 6v14M6 18h14M442 6v14M454 18h-14M18 514v-14M6 502h14M442 514v-14M454 502h-14"/>
        </g>
        <!-- registration target -->
        <g transform="translate(230 14)" stroke="#0f1a33" fill="none" stroke-width="1"><circle r="6"/><path d="M-10 0h20M0 -10v20"/></g>
        <!-- banner -->
        <rect x="40" y="40" width="380" height="110" fill="#0f1a33"/>
        <rect x="40" y="40" width="380" height="110" fill="none" stroke="#e5197d" stroke-width="1" stroke-dasharray="4 3" transform="translate(-4 -4)" opacity=".0"/>
        <rect x="58" y="62" width="150" height="14" fill="#fff"/>
        <rect x="58" y="86" width="230" height="10" fill="#00a0dc"/>
        <rect x="58" y="106" width="100" height="24" fill="#ffd400"/>
        <text x="40" y="166">Flex banner, 3:1</text>
        <!-- poster -->
        <rect x="40" y="184" width="150" height="212" fill="#fff" stroke="#0f1a33"/>
        <rect x="52" y="196" width="126" height="90" fill="#e5197d"/>
        <circle cx="115" cy="241" r="26" fill="#ffd400"/>
        <rect x="52" y="298" width="90" height="10" fill="#0f1a33"/>
        <rect x="52" y="316" width="126" height="6" fill="#9aa4bb"/>
        <rect x="52" y="330" width="110" height="6" fill="#9aa4bb"/>
        <text x="40" y="412">Poster, A2</text>
        <!-- t-shirt -->
        <path d="M232 190l32-12c6 14 24 14 30 0l32 12 22 40-28 14-8-14v130h-94V230l-8 14-28-14z" fill="#00a0dc"/>
        <rect x="262" y="236" width="40" height="30" fill="#fff"/>
        <text x="232" y="412">T-shirt, front print</text>
        <!-- mug -->
        <rect x="345" y="330" width="54" height="66" rx="4" fill="#ffd400" stroke="#0f1a33"/>
        <path d="M399 344h10a10 10 0 0 1 0 36h-10" fill="none" stroke="#0f1a33" stroke-width="5"/>
        <text x="345" y="412">Mug wrap</text>
        <!-- colour bar -->
        <g transform="translate(40 440)">
          <rect width="60" height="20" fill="#00a0dc"/>
          <rect x="60" width="60" height="20" fill="#e5197d"/>
          <rect x="120" width="60" height="20" fill="#ffd400"/>
          <rect x="180" width="60" height="20" fill="#0f1a33"/>
          <rect x="240" width="60" height="20" fill="#7f8ba6"/>
          <rect x="300" width="80" height="20" fill="none" stroke="#0f1a33"/>
        </g>
        <text x="40" y="484">C   M   Y   K  colour check before every run</text>
      </svg>
    </div>
  </div>
</section>
