---
import { getCollection } from 'astro:content';
import { site } from '../site';
interface Props { selected?: string }
const { selected = '' } = Astro.props;
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---
<section class="section" id="quote" data-track-area="quote_section">
  <div class="wrap quote-grid">
    <div class="quote-aside">
      <h2 data-reveal="words">Tell us what you need printed</h2>
      <p>Share the item, size and quantity. We reply with a price and a proof plan, and nothing is printed until you approve.</p>
      <ul class="contact-list">
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        {site.phone && <li><a href={`tel:${site.phone.replace(/\s/g, '')}`}>Call {site.phone}</a></li>}
        {site.whatsapp && <li><a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener">WhatsApp {site.phone}</a></li>}
      </ul>
    </div>

    <form class="quote" data-reveal="feed" id="quote-form" data-whatsapp={site.whatsapp} data-email={site.email}>
      <div class="row2">
        <div class="field">
          <label for="q-name">Your name</label>
          <input id="q-name" name="name" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="q-contact">Phone or email</label>
          <input id="q-contact" name="contact" autocomplete="email" required />
        </div>
      </div>
      <div class="row2">
        <div class="field">
          <label for="q-product">What do you need?</label>
          <select id="q-product" name="product" required>
            <option value="">Choose a product type</option>
            {services.map((s) => <option value={s.data.title} selected={s.id === selected}>{s.data.title}</option>)}
            <option value="Something else">Something else</option>
          </select>
        </div>
        <div class="field">
          <label for="q-qty">Quantity</label>
          <input id="q-qty" name="qty" inputmode="numeric" placeholder="e.g. 50" />
        </div>
      </div>
      <div class="field">
        <label for="q-details">Size, material and deadline</label>
        <textarea id="q-details" name="details" placeholder="e.g. 10 x 3 ft flex banner for an event on 15 Oct"></textarea>
        <span class="hint">No artwork yet? Say so and we will help with the design.</span>
      </div>
      <button class="btn" type="submit">{site.whatsapp ? 'Send request on WhatsApp' : 'Request my quote'}</button>
      <p class="hint" id="q-status" role="status"></p>
    </form>
  </div>
</section>

<script>
  import { track } from '../scripts/analytics';

  const form = document.getElementById('quote-form') as HTMLFormElement | null;
  const status = document.getElementById('q-status');
  const formParams = () => ({ form_name: 'quote', form_location: window.location.pathname });

  // First interaction with the form
  let started = false;
  form?.addEventListener('focusin', () => {
    if (started) return;
    started = true;
    track('quote_form_start', formParams());
  });

  // Browser validation stopped the submit. `invalid` fires per field, so report only the first one per attempt.
  let errorQueued = false;
  form?.addEventListener('invalid', (e) => {
    if (errorQueued) return;
    errorQueued = true;
    track('quote_form_error', { ...formParams(), field: (e.target as HTMLInputElement).name });
    setTimeout(() => (errorQueued = false), 0);
  }, true);

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const d = new FormData(form);
    const body = [
      `Name: ${d.get('name')}`,
      `Contact: ${d.get('contact')}`,
      `Product: ${d.get('product')}`,
      `Quantity: ${d.get('qty') || 'not sure'}`,
      `Details: ${d.get('details') || '-'}`,
    ].join('\n');
    const wa = form.dataset.whatsapp;
    const url = wa
      ? `https://wa.me/${wa}?text=${encodeURIComponent('Quote request\n' + body)}`
      : `mailto:${form.dataset.email}?subject=${encodeURIComponent('Quote request')}&body=${encodeURIComponent(body)}`;
    if (status) status.textContent = wa ? 'Opening WhatsApp with your request.' : 'Opening your email app with your request.';

    // The Lead: the form is valid and we are handing the request to WhatsApp (or email).
    // Only non-personal details go to GA. Navigation waits for GA to confirm the hit (max 1s).
    const qty = Number(String(d.get('qty') || '').replace(/[^\d]/g, '')) || undefined;
    track('generate_lead', {
      ...formParams(),
      lead_source: 'quote_form',
      method: wa ? 'whatsapp' : 'email',
      product_type: String(d.get('product') || ''),
      quantity: qty,
      has_details: Boolean(String(d.get('details') || '').trim()),
    }, () => { window.location.href = url; });
  });
</script>
