---
import { getCollection } from 'astro:content';
import { serviceImage } from '../lib/serviceImage';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---
<ul class="service-list">
  {services.map((s) => {
    const img = serviceImage(s);
    return (
      <li>
        <a class="service-row" href={`/services/${s.id}/`}>
          <img class="row-thumb" src={img.src} alt="" width="480" height="360" loading="lazy" decoding="async" />
          <h3>{s.data.title}<span class="spec">{s.data.spec}</span></h3>
          <div>
            <p>{s.data.summary}</p>
            <ul class="chips">{s.data.items.map((i) => <li>{i}</li>)}</ul>
          </div>
          <span class="row-go">View details</span>
        </a>
      </li>
    );
  })}
</ul>
