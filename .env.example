# Admin panel (/admin). Copy to .env for local use. Never commit real values.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-to-a-long-password
# Random string, at least 32 characters. e.g. `openssl rand -base64 48`
SESSION_SECRET=replace-with-a-long-random-string
# Fine-grained token: this repo only, Contents read and write
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx
GITHUB_REPO=AhmadSaeed10/SigmaPrinto
GITHUB_BRANCH=main
